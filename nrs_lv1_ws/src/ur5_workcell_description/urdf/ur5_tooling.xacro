<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find robotiq_3f_description)/urdf/robotiq_3f.xacro"/>
  <xacro:include filename="$(find robotiq_ft300s_description)/urdf/robotiq_ft300s.xacro"/>
  <xacro:macro name="ur5_workcell_tooling"
               params="tool0 prefix:='' include_cable_plugs:=true articulated_gripper:=true gripper_joint_damping:=1.0 gripper_joint_friction:=0.1">
    <!-- Students add the FT300S between tool0 and the gripper. -->
    <xacro:property name="ft300_sensor_z" value="0.0415"/>
    <xacro:property name="ft300_sensor_height" value="0.0375"/>  <!-- PROVJERITI -->

    <!-- 1. FT300S izravno na prirubnicu robota -->
    <xacro:robotiq_ft300s parent="${tool0}" prefix="${prefix}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:robotiq_ft300s>

    <!-- 2. Okvir na alatnoj strani senzora (orijentacija jednaka ploči) -->
    <link name="${prefix}ft300_tool_face"/>
    <joint name="${prefix}ft300_tool_face_joint" type="fixed">
      <parent link="${prefix}ft300_mounting_plate"/>
      <child link="${prefix}ft300_tool_face"/>
      <origin xyz="0 0 ${ft300_sensor_z + ft300_sensor_height}" rpy="0 0 0"/>
    </joint>
    
    <xacro:robotiq_3f_gripper parent="${prefix}ft300_tool_face" prefix="${prefix}"
      include_cable_plugs="${include_cable_plugs}" articulated="${articulated_gripper}"
      joint_damping="${gripper_joint_damping}" joint_friction="${gripper_joint_friction}">
      <origin xyz="0 0 0.0127" rpy="1.5707963267948966 0 -0.7853981633974483"/>
    </xacro:robotiq_3f_gripper>

    <!-- Okvir vrška prsta A za dodir s vratima -->
    <link name="${prefix}finger_tip"/>
    <joint name="${prefix}finger_tip_joint" type="fixed">
      <parent link="${prefix}AGS_finger-dist002"/>
      <child link="${prefix}finger_tip"/>
      <!-- PLACEHOLDER: odrediti iz mesha ili vizualno u RViz-u -->
      <origin xyz="0 0 0.038" rpy="0 0 0"/>
    </joint>

  </xacro:macro>
</robot>
